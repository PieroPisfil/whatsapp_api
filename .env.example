PORT=3000

# Auth (JWT_SECRET debe tener al menos 32 caracteres)
SECRET_WORD=cambia_esta_palabra_secreta
JWT_SECRET=cambia_este_jwt_secret_de_al_menos_32_chars

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Webhooks (coma-separadas). Se persisten en Redis tras el primer arranque/API.
WEBHOOK_URLS=https://tu-servidor-externo.com/webhook/whatsapp
# Firma HMAC enviada en header X-Webhook-Signature: sha256=<hex>
WEBHOOK_SECRET=cambia_este_webhook_secret_largo

# Límites de payload
BODY_LIMIT=10mb
MAX_MEDIA_BYTES=8388608
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MEDIA_TIMEOUT_MS=15000

# Puppeteer / Chromium (Docker)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
